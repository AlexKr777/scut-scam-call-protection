@echo off
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "& { $root=(Resolve-Path '%~dp0..').Path; $status=Join-Path $root 'reports\scut_semantic_brain_v2_pc5070\runtime_status.json'; if (!(Test-Path $status)) { Write-Host 'SCUT STAGE 2 STATUS: NOT STARTED'; exit 0 }; $s=Get-Content -Raw $status | ConvertFrom-Json; $alive=if ($s.pid) {[bool](Get-Process -Id $s.pid -ErrorAction SilentlyContinue)} else {$false}; Write-Host ('SCUT STAGE 2 STATUS: '+$s.state); Write-Host ('PID: '+$s.pid+' (alive: '+$alive+')'); Write-Host ('Start: '+$s.start_time_utc); if ($s.end_time_utc) { Write-Host ('End: '+$s.end_time_utc) }; if ($null -ne $s.exit_code) { Write-Host ('Exit code: '+$s.exit_code) }; Write-Host ('Stdout: '+$s.stdout_log); Write-Host ('Stderr: '+$s.stderr_log); Write-Host 'Latest progress:'; if (Test-Path $s.stdout_log) { Get-Content $s.stdout_log -Tail 4 }; if (Test-Path $s.stderr_log) { Get-Content $s.stderr_log -Tail 8 }; if ($s.state -eq 'RUNNING' -and (Get-Command nvidia-smi -ErrorAction SilentlyContinue)) { Write-Host 'GPU:'; & nvidia-smi --query-gpu=utilization.gpu,memory.used,memory.total,temperature.gpu --format=csv,noheader } }"
