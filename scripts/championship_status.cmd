@echo off
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "& { $root=(Resolve-Path '%~dp0..').Path; $path=Join-Path $root 'reports\scut_brain_championship_pc5070\runtime_status.json'; if (!(Test-Path -LiteralPath $path)) { Write-Host 'SCUT BRAIN CHAMPIONSHIP: NOT STARTED'; exit 0 }; $s=Get-Content -LiteralPath $path -Raw | ConvertFrom-Json; $alive=if ($s.pid) {[bool](Get-Process -Id $s.pid -ErrorAction SilentlyContinue)} else {$false}; Write-Host ('Phase: '+$s.phase+'  PID: '+$s.pid+' (alive: '+$alive+')'); Write-Host ('Elapsed/start: '+$s.start_time_utc+'  Updated: '+$s.updated_at_utc); Write-Host ('Fits: '+$s.fit_completed+'/'+$s.fit_total); Write-Host ('Current: candidate='+$s.candidate+' revision='+$s.revision+' depth='+$s.depth+' fold='+$s.fold+' seed='+$s.seed+' epoch='+$s.epoch); if ($s.metrics) { Write-Host ('Metrics: '+($s.metrics | ConvertTo-Json -Compress -Depth 3)) }; Write-Host ('Stdout: '+$s.stdout_log); Write-Host ('Stderr: '+$s.stderr_log); if ($s.stdout_log -and (Test-Path -LiteralPath $s.stdout_log)) { Write-Host 'Latest stdout:'; Get-Content -LiteralPath $s.stdout_log -Tail 8 }; if ($s.stderr_log -and (Test-Path -LiteralPath $s.stderr_log)) { Write-Host 'Latest stderr:'; Get-Content -LiteralPath $s.stderr_log -Tail 8 }; if (Get-Command nvidia-smi -ErrorAction SilentlyContinue) { Write-Host 'GPU:'; & nvidia-smi --query-gpu=name,utilization.gpu,memory.used,memory.total,temperature.gpu --format=csv,noheader } }"
