@echo off
powershell.exe -NoProfile -Command "& { $root=(Resolve-Path '%~dp0..').Path; $path=Join-Path $root 'runtime\audio_replay_v1\status.json'; if (!(Test-Path -LiteralPath $path)) { Write-Host 'SCUT AUDIO REPLAY V1: NOT STARTED'; exit 0 }; $s=Get-Content -LiteralPath $path -Raw | ConvertFrom-Json; $alive=if($s.pid){[bool](Get-Process -Id $s.pid -ErrorAction SilentlyContinue)}else{$false}; Write-Host 'SCUT AUDIO REPLAY V1'; Write-Host ''; Write-Host ('State: '+$s.state+'  Phase: '+$s.phase+'  PID alive: '+$alive); Write-Host ('Run: '+$s.run_id); Write-Host ('Completed: '+$s.completed_cases+' / '+$s.total_cases+'  Failed: '+$s.failed_cases+'  Remaining: '+$s.remaining_cases); Write-Host ('Current: '+$s.current_case_id+'  Language: '+$s.current_language+'  Expected: '+$s.current_expected_class+'  Source: '+$s.current_source_type); Write-Host ('Updated: '+$s.updated_at); if($s.reports){Write-Host ('Report: '+$s.reports.markdown)} }"
