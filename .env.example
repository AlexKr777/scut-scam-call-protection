# Optional hosted AI analysis. Leave disabled to use local-only risk analysis.
SCUT_AI_ENABLED=false
SCUT_AI_PROVIDER=anymodel
SCUT_AI_API_KEY=your_api_key_here
SCUT_AI_BASE_URL=https://anymodel.org/v1
SCUT_AI_MODEL=your_model_id_here
SCUT_AI_TIMEOUT_SECONDS=20
SCUT_AI_JSON_MODE=true

# Local runtime configuration. The Electron app sets SCUT_LOCAL_DIR for packaged builds.
SCUT_LOCAL_DIR=C:\\path\\to\\SCUT-local-state
SCUT_PORT=8765
SCUT_ASR_MODE=turbo_cuda
SCUT_WHISPER_DEVICE=cuda
SCUT_VALIDATION_MODEL=your_local_model_id_here

# Optional cloud control-plane client configuration.
SCUT_SUPABASE_URL=https://your-project.supabase.co
SCUT_EXE_CONTROL_TOKEN=your_local_control_token_here
